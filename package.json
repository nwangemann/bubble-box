{
  "name": "bubble-box",
  "version": "0.1.0",
  "description": "A calm physics toy for iPhone: bubbles grown under a finger and sent into a 3D box. Expo, React Native and Skia.",
  "main": "index.ts",
  "dependencies": {
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-haptics": "~58.0.8",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web:build": "setup-skia-web public && expo export --platform web && node scripts/web-finish.mjs",
    "web:serve": "node scripts/web-serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && prettier --check . && npm test"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
